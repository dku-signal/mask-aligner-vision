# One line-ending style in the repo (LF) whatever each OS's git settings are.
# Windows users still get files that run; Python and Arduino accept LF.
* text=auto eol=lf
*.py text eol=lf
*.ino text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.jpg binary
*.png binary
